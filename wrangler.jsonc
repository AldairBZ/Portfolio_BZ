{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-15",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // La API y el panel los atiende el Worker; el resto, los archivos estáticos
    "run_worker_first": ["/api/*", "/panel"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "portfolio-visitas",
      "database_id": "pendiente-de-crear",
      "migrations_dir": "migrations"
    }
  ],
  "observability": { "enabled": true }
}
